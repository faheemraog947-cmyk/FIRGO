import 'package:flutter/material.dart';

class CommissionWidget extends StatelessWidget {
  final double totalFare;
  final double commissionRatePercentage; // Default FIRGO rate e.g. 10%

  const CommissionWidget({
    Key? key,
    required this.totalFare,
    this.commissionRatePercentage = 10.0,
  }) : super(key: key);

  @override
  Widget build(BuildContext context) {
    double platformFee = (totalFare * commissionRatePercentage) / 100;
    double driverEarning = totalFare - platformFee;

    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: const Color(0xFF1A1A1A),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: const Color(0xFFFFBF00), width: 0.8),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'Driver Earning',
                style: TextStyle(color: Colors.grey, fontSize: 11),
              ),
              Text(
                'Rs. ${driverEarning.toStringAsFixed(0)}',
                style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14),
              ),
            ],
          ),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(
                'FIRGO Fee (${commissionRatePercentage.toInt()}%)',
                style: const TextStyle(color: Colors.grey, fontSize: 11),
              ),
              Text(
                'Rs. ${platformFee.toStringAsFixed(0)}',
                style: const TextStyle(color: Color(0xFFFFBF00), fontWeight: FontWeight.bold, fontSize: 14),
              ),
            ],
          ),
        ],
      ),
    );
  }
}